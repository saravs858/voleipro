<%- include('../../partials/header') %>

<div class="admin-page">
<h1>Admin • Treinos</h1>

<a href="/admin/trainings/new">+ Novo Treino</a>

<ul>
  <% trainings.forEach(training => { %>
    <li>
      <strong><%= training.title %></strong>
      (<%= training.difficulty %>)

      <a href="/admin/trainings/edit/<%= training._id %>">Editar</a>

      <form action="/admin/trainings/delete/<%= training._id %>" method="POST" style="display:inline">
        <button type="submit">Apagar</button>
      </form>
    </li>
  <% }) %>
</ul>
</div>

<%- include('../../partials/footer') %>